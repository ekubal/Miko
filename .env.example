# Gemini API (Nano Banana Pro, Veo 3.1, tekst): https://aistudio.google.com/apikey
GEMINI_API_KEY=
# ElevenLabs (głos i muzyka): https://elevenlabs.io/app/settings/api-keys
ELEVENLABS_API_KEY=
# Opcjonalnie: gotowy głos Mikołaja (inaczej używany jest output/voice.json)
ELEVENLABS_VOICE_ID=

