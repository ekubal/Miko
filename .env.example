# Gemini API (Nano Banana Pro, Gemini Omni Flash, tekst): https://aistudio.google.com/apikey
GEMINI_API_KEY=
# ElevenLabs (głos i muzyka): https://elevenlabs.io/app/settings/api-keys
ELEVENLABS_API_KEY=
# Opcjonalnie: gotowy głos Mikołaja (inaczej używany jest output/voice.json)
ELEVENLABS_VOICE_ID=
# Opcjonalnie: zestaw ustawień głosu z generator/audio.py (v4, v4_ekspresja, naturalny, v3, flash_pl,
# dotychczasowy); porównanie: python -m generator.audio probki
# ELEVENLABS_PRESET=v4
# ELEVENLABS_TTS_MODEL=eleven_v4
# ELEVENLABS_VOICE_DESIGN_MODEL=eleven_ttv_v3
# ELEVENLABS_STS_MODEL=eleven_multilingual_sts_v2

# Opcjonalnie: fal.ai, tylko do testów innych modeli wideo (testy_fal/): https://fal.ai/dashboard/keys
FAL_KEY=

# Opcjonalne nadpisania modeli i katalogu wyjściowego
# MIKOLAJ_IMAGE_MODEL=gemini-3-pro-image-preview
# MIKOLAJ_VIDEO_MODEL=gemini-omni-1.1-flash
# MIKOLAJ_TEXT_MODEL=gemini-2.5-flash
# Cennik modelu obrazu do podglądu kosztu (USD za 1 mln tokenów)
# MIKOLAJ_IMAGE_PRICE_INPUT=2.0
# MIKOLAJ_IMAGE_PRICE_OUTPUT_IMAGE=120.0
# MIKOLAJ_IMAGE_PRICE_OUTPUT_TEXT=12.0
# MIKOLAJ_OUTPUT_DIR=output
